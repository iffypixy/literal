{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "literal",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Served at literal.ink alone: sign-in and sync only work at APP_URL, so there's no workers.dev copy.
  "routes": [{ "pattern": "literal.ink", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sync"],
  },
  "durable_objects": {
    "bindings": [{ "name": "NOTES", "class_name": "UserNotes" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserNotes"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "literal",
      // From `wrangler d1 create literal`: another deployment puts its own here.
      "database_id": "bc547f81-639d-4ce6-a0fc-374a8d5d4b60",
      "migrations_dir": "worker/migrations",
    },
  ],
  // Sign-in codes, sent from literal.ink once `wrangler email sending enable literal.ink` has set it up.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["code@literal.ink"] }],
  "observability": { "enabled": true },
  "vars": {
    // The one secret, BETTER_AUTH_SECRET, goes in with `wrangler secret put`.
    "APP_URL": "https://literal.ink",
    "EMAIL_FROM": "code@literal.ink",
  },
}
