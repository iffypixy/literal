{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "literal",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sync"],
  },
  "durable_objects": {
    "bindings": [{ "name": "NOTES", "class_name": "UserNotes" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserNotes"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "literal",
      // Replace with the id `wrangler d1 create literal` prints.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations",
    },
  ],
  // Sign-in codes, sent from literal.ink once `wrangler email sending enable literal.ink` has set it up.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["code@literal.ink"] }],
  "observability": { "enabled": true },
  "vars": {
    // The one secret, BETTER_AUTH_SECRET, goes in with `wrangler secret put`.
    "APP_URL": "https://literal.ink",
    "EMAIL_FROM": "code@literal.ink",
  },
}
