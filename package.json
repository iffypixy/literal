{
  "name": "literal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5390 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host --port 5390 --strictPort",
    "check": "tsc && tsc -p tsconfig.node.json && tsc -p server && oxlint --type-aware --deny-warnings && oxfmt --check",
    "deploy": "pnpm check && vite build && wrangler d1 migrations apply literal --remote && wrangler deploy --config web/dist/literal/wrangler.json",
    "test": "playwright test",
    "format": "oxfmt"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "lib0": "0.2.119",
    "solid-js": "1.9.17",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.4"
}
